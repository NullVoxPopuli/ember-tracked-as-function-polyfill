{
  "name": "v2-addon",
  "version": "0.0.0",
  "description": "Test fixture: v2 addon that uses tracked() from @glimmer/tracking",
  "keywords": [
    "ember-addon"
  ],
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./addon-main.js": "./addon-main.cjs",
    "./*": "./dist/*.js"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "prepack": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "decorator-transforms": "^2.3.0",
    "ember-tracked-as-function-polyfill": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@embroider/addon-dev": "^8.1.0",
    "@glimmer/component": "^2.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "ember-source": "~6.12.0",
    "rollup": "^4.22.5"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/v2-counter.js": "./dist/_app_/components/v2-counter.js"
    }
  },
  "private": true,
  "peerDependencies": {
    "@glimmer/component": ">= 1.1.2",
    "ember-source": ">= 3.28.0"
  }
}
